# ==============================================================================
# SAGE PAPER STUDIO · ENVIRONMENT VARIABLES
# ==============================================================================

# --- VERCEL NEON POSTGRESQL ---
# In Vercel la Neon integration ha già creato `spdmanager_DATABASE_URL`.
# In locale copia quel valore qui come DATABASE_URL (non committare mai .env).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- GEMINI AI & APP URL ---
# Inclusa automaticamente dall'ambiente per le funzionalità intelligenti e stime
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- FIREBASE & OAUTH ---
# I parametri di configurazione dell'applet risiedono in firebase-applet-config.json:
# (projectId: elite-poetry-r9nlt, firestoreDatabaseId, oAuthClientId)

# --- GOOGLE CALENDAR OAUTH (Opzionale per sincronizzazione calendario) ---
# Se non specificato, il sistema rileva in automatico l'oAuthClientId da firebase-applet-config.json
VITE_GOOGLE_CLIENT_ID="21976513139-urh8l08upc1q2bqdapa1i5qv0jlvggnp.apps.googleusercontent.com"

# --- SUPABASE (Opzionale: backup e snapshot manuali) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"


