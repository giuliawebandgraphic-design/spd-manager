# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: Required for Supabase PostgreSQL, Authentication, and Storage.
# Obtain from your Supabase Project Settings -> API.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# GOOGLE CALENDAR OAUTH: Client ID for Google Calendar API integration.
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

