# ==============================================================================
# SAGE PAPER STUDIO · ENVIRONMENT VARIABLES
# ==============================================================================

# --- CLOUD SQL (PostgreSQL Relazionale) ---
# Queste variabili vengono iniettate automaticamente dall'ambiente AI Studio / Cloud Run:
# - SQL_HOST: percorso socket proxy Cloud SQL Auth
# - SQL_DB_NAME: nome database relazionale
# - SQL_USER: utente applicativo per query e pool di connessione
# - SQL_PASSWORD: password utente applicativo
# - SQL_ADMIN_USER: utente amministrativo per Drizzle Kit migrations
# - SQL_ADMIN_PASSWORD: password amministrativa per Drizzle Kit

# --- GEMINI AI & APP URL ---
# Inclusa automaticamente dall'ambiente per le funzionalità intelligenti e stime
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --- FIREBASE & OAUTH ---
# I parametri di configurazione dell'applet risiedono in firebase-applet-config.json:
# (projectId: elite-poetry-r9nlt, firestoreDatabaseId, oAuthClientId)

# --- GOOGLE CALENDAR OAUTH (Opzionale per sincronizzazione calendario) ---
# Se non specificato, il sistema rileva in automatico l'oAuthClientId da firebase-applet-config.json
VITE_GOOGLE_CLIENT_ID="21976513139-urh8l08upc1q2bqdapa1i5qv0jlvggnp.apps.googleusercontent.com"

# --- SUPABASE (Opzionale: backup e snapshot manuali) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"


